# --- LeetCode ---------------------------------------------------------------
# Copy LEETCODE_SESSION and csrftoken from your browser's cookies on leetcode.com
# (DevTools -> Application -> Cookies). The session cookie gives full account
# access and expires every few weeks; DSA Recall only reads data.
LEETCODE_USERNAME=
LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=

# --- LLM (any OpenAI-compatible API) -----------------------------------------
# Option A: OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=              # default model for all tasks
LLM_MODEL_SOLUTION=     # optional per-task override (solution analysis)

# Option B: Ollama (local, no key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5-coder:14b

# --- App ---------------------------------------------------------------------
# Dev and prod use separate databases (data/dsa-recall.dev.db and data/dsa-recall.db).
# Only the `dsa-recall` launcher and `--prod` flags use prod. Do NOT set DSA_RECALL_ENV
# here: it would make prod the default for every dev tool.
# DATABASE_PATH=        # optional explicit path; overrides both
